{
  "name": "@interop/web-spaces-server",
  "description": "A reference Portable Web Spaces (PWS) server.",
  "version": "0.46.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "common",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx watch src/start.js",
    "start": "node dist/start.js",
    "start:pretty": "node dist/start.js | pino-pretty",
    "build": "pnpm run clear && tsc && pnpm run copy-assets && pnpm run write-build-info",
    "clear": "rimraf dist/*",
    "copy-assets": "node -e \"require('node:fs').cpSync('src/views','dist/views',{recursive:true})\"",
    "write-build-info": "tsx scripts/write-build-info.ts",
    "rebuild": "pnpm run clear && pnpm run build",
    "lint": "eslint src test scripts && pnpm run lint:dup",
    "lint:dup": "jscpd",
    "lint:tests": "tsc -p tsconfig.dev.json",
    "fix": "eslint --fix src test scripts && pnpm run format",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"*.md\"",
    "test-node": "vitest run",
    "test:pg": "WAS_TEST_DATABASE_URL=postgres://was:was@localhost:5433/was vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm run fix && pnpm run lint && pnpm run lint:tests && pnpm run build && pnpm run test-node",
    "conformance": "pws-conformance",
    "conformance:local": "tsx scripts/conformance-local.ts",
    "reencrypt-kms-records": "tsx scripts/reencrypt-kms-records.ts",
    "perf:fs": "tsx scripts/performance/perf-fs.ts",
    "perf:fs:seed": "tsx scripts/performance/perf-fs-seed.ts",
    "perf:pg": "tsx scripts/performance/perf-pg.ts",
    "perf:pg:seed": "tsx scripts/performance/perf-pg-seed.ts",
    "perf:remote": "tsx scripts/performance/perf-remote.ts",
    "roadmap": "node scripts/roadmap-order.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@interop/bnid": "^6.0.2",
    "@interop/data-integrity-core": "^8.11.0",
    "@interop/data-integrity-proof": "^3.4.8",
    "@interop/did-method-key": "^7.5.2",
    "@interop/did-method-webvh": "^5.18.2",
    "@interop/ed25519-signature": "^7.2.5",
    "@interop/ed25519-verification-key": "^8.2.2",
    "@interop/ezcap": "^7.5.4",
    "@interop/http-digest-header": "^3.2.0",
    "@interop/http-signature-header": "^5.0.3",
    "@interop/http-signature-zcap-invoke": "^6.3.0",
    "@interop/http-signature-zcap-verify": "^12.2.7",
    "@interop/jsonld-signatures": "^11.9.0",
    "@interop/lru-memoize": "^4.0.3",
    "@interop/minimal-cipher": "^7.11.1",
    "@interop/security-document-loader": "^10.1.6",
    "@interop/space-archive": "^0.12.0",
    "@interop/storage-core": "^0.45.0",
    "@interop/x25519-key-agreement-key": "^5.4.3",
    "@interop/zcap": "^11.4.0",
    "@scure/base": "^2.4.0",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "handlebars": "^4.7.9",
    "lru-cache": "11.5.2",
    "mime-types": "^3.0.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tar-stream": "^3.2.0",
    "undici": "8.10.0",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@interop/did-cli": "^0.18.0",
    "@interop/pws-client": "^0.108.0",
    "@interop/pws-conformance-suite": "^0.38.0",
    "@interop/webkms-client": "^15.0.3",
    "@types/mime-types": "3.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jscpd": "^5.4.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "bin": {},
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0"
  },
  "author": {
    "name": "Dmitri Zagidulin",
    "url": "https://github.com/dmitrizagidulin/"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/interop-alliance/web-spaces-server"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/interop-alliance/web-spaces-server",
  "bugs": "https://github.com/interop-alliance/web-spaces-server/issues"
}
